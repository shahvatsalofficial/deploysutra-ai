{
  "name": "deploysutra-ai",
  "version": "0.2.0",
  "description": "DeploySutra AI: offline, read-only deployment risk and reversibility analysis for Kubernetes manifests and OpenTofu/Terraform plans. Source-linked diffs, 19 stable policy rules, blast-radius map, a rollback-evidence gate that can never say READY, MD/HTML/JSON audit reports, an MCP server and 25 portable Agent Skills for Claude Code, Cursor, Codex, Copilot and Gemini CLI. No API keys, no cluster access.",
  "author": {
    "name": "Vatsal Shah",
    "url": "https://github.com/shahvatsalofficial"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "deploysutra": "packages/cli/index.mjs",
    "deploysutra-ai": "packages/cli/index.mjs"
  },
  "main": "packages/core/index.mjs",
  "exports": {
    ".": "./packages/core/index.mjs",
    "./reporting": "./packages/reporting/index.mjs",
    "./audit": "./packages/core/audit.mjs",
    "./mcp": "./packages/server/mcp.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "doctor": "node packages/cli/index.mjs doctor",
    "demo": "node scripts/demo.mjs",
    "analyze": "node packages/cli/index.mjs analyze --before fixtures/k8s/before.yaml --after fixtures/k8s/after.yaml --out examples/reports/demo",
    "audit": "node packages/cli/index.mjs audit --out examples/audit",
    "pack:check": "npm pack --dry-run",
    "proof": "node scripts/proof.mjs",
    "generate:skills": "node scripts/generate-skills.mjs"
  },
  "homepage": "https://github.com/shahvatsalofficial/deploysutra-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shahvatsalofficial/deploysutra-ai.git"
  },
  "bugs": {
    "url": "https://github.com/shahvatsalofficial/deploysutra-ai/issues"
  },
  "keywords": [
    "deployment",
    "deployment-risk",
    "release-gate",
    "rollback",
    "kubernetes",
    "k8s",
    "manifest",
    "policy-as-code",
    "devsecops",
    "sre",
    "platform-engineering",
    "opentofu",
    "terraform",
    "iac",
    "blast-radius",
    "change-management",
    "agent-skills",
    "claude-code",
    "cursor",
    "codex",
    "github-copilot",
    "gemini-cli",
    "mcp",
    "model-context-protocol",
    "audit",
    "offline",
    "cli",
    "llm"
  ],
  "files": [
    "packages",
    "scripts/install.sh",
    "scripts/install.ps1",
    "scripts/install.cmd",
    "skills",
    "agents",
    ".claude/agents",
    ".claude-plugin",
    "fixtures",
    "schemas",
    "rules",
    "policies",
    "workflows",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "SECURITY.md",
    "llms.txt"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
